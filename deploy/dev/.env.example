# Copy to deploy/dev/.env (git-ignored). `make env` generates one with random secrets.
PHOTOSTEAD_DB_PASSWORD=
PHOTOSTEAD_DATABASE_URL=postgres://photostead:${PHOTOSTEAD_DB_PASSWORD}@127.0.0.1:5433/photostead?sslmode=disable
# Where derived files (thumbnails, previews) go during development.
PHOTOSTEAD_DATA_DIR=${HOME}/photostead-dev/data
PHOTOSTEAD_LISTEN=127.0.0.1:4800
# First-run admin account, created only when no users exist.
PHOTOSTEAD_ADMIN_EMAIL=
PHOTOSTEAD_ADMIN_PASSWORD=
