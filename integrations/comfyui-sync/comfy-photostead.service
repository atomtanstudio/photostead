[Unit]
Description=Copy ComfyUI images and videos to Photostead
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/ai/comfy-photostead
ExecStart=/usr/bin/python3 /srv/ai/comfy-photostead/photostead_sync.py --env-file /srv/ai/comfy-photostead/.env
Restart=on-failure
RestartSec=30
UMask=0077
NoNewPrivileges=true
Nice=10
TimeoutStopSec=600

[Install]
WantedBy=default.target
