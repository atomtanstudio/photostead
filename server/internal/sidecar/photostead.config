# ExifTool config: Photostead's own XMP namespace, for what the standard ones have no tag for.
# (Loaded with -config when Photostead writes a sidecar.)
%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        photostead => {
            SubDirectory => { TagTable => 'Image::ExifTool::UserDefined::photostead' },
        },
    },
);

%Image::ExifTool::UserDefined::photostead = (
    GROUPS    => { 0 => 'XMP', 1 => 'XMP-photostead', 2 => 'Image' },
    NAMESPACE => { 'photostead' => 'https://photostead.com/ns/xmp/1.0/' },
    WRITABLE  => 'string',
    Favorite   => { Writable => 'boolean' }, # the owner's favorite
    Flag       => { },                       # pick or reject
    AIModel    => { },                       # the model an AI item was made with
    EditRecipe => { },                       # a photo's edit (JSON: turn, mirror, crop, light, color)
);

1;
